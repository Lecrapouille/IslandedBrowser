# Personal data: exported bookmarks, organization, files for Firefox.
private/

# Safety net: any JSON could be a personal export saved in the wrong place.
# Only the public example files of examples/ are versioned.
*.json
!examples/bookmarks.json
!examples/organization.json
!examples/layout.json
# Files for Firefox made from the example: not versioned.
examples/organized.*

# Screenshots (key S, --screenshot)
*.png
!doc/*.png

# Build
build/
*.o
*.d

# Python
__pycache__/
*.pyc

# Editors
*~
.vscode/
.idea/
